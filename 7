%{
#include <stdio.h>
%}

%%
[01]+ {
    int z = 0, o = 0;

    /* Count 0s and 1s */
    for(int i = 0; yytext[i] != '\0'; i++)
    {
        if(yytext[i] == '0')
            z++;
        else if(yytext[i] == '1')
            o++;
    }

    /* Check even number of 0s and 1s */
    if(z % 2 == 0 && o % 2 == 0)
        printf("Accepted: Even number of 0s and 1s\n");
    else
        printf("Rejected: Number of 0s or 1s is odd\n");
}

[^01\n]+ {
    printf("Invalid string\n");
}

\n ;

%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter a string containing only 0 and 1: ");
    yylex();
    return 0;
}



